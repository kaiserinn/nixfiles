configuration {
    modi: "run,drun,window,filebrowser,keys";
    icon-theme: "Qogir-dark";
    show-icons: false;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: true;
}

